# 多阶段构建：统一镜像包含 web + bridge + wss-server

# 支持自定义镜像源，默认使用官方镜像
ARG REGISTRY=""

# ========== 构建阶段 ==========
FROM ${REGISTRY}oven/bun:1 AS builder

WORKDIR /build

# 复制整个 monorepo
COPY . .

# 安装根目录依赖
RUN bun install

# 构建 web 前端
WORKDIR /build/packages/web
RUN bun run build

# 构建 opencode-qwen-acp-demo
WORKDIR /build/packages/opencode-qwen-acp-demo
RUN bun run build

# ========== 运行阶段 ==========
FROM ${REGISTRY}oven/bun:1-slim

WORKDIR /app

# 安装基础工具（仅保留 HTTPS 必需的证书）
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 复制 web 构建产物
COPY --from=builder /build/packages/web/dist ./web/dist
COPY --from=builder /build/packages/web/package.json ./web/

# 复制 bridge
COPY --from=builder /build/packages/bridge ./bridge

# 复制 wss-server
COPY --from=builder /build/packages/opencode-qwen-acp-demo/dist ./wss/dist
COPY --from=builder /build/packages/opencode-qwen-acp-demo/package.json ./wss/
COPY --from=builder /build/packages/opencode-qwen-acp-demo/node_modules ./wss/node_modules

# 安装生产依赖（bridge）
WORKDIR /app/bridge
RUN bun install --production

# 创建工作目录
RUN mkdir -p /workspace

# 暴露端口
# 3000: web 前端
# 4001: wss-server (WebSocket ACP)
# 4096: bridge (HTTP API)
EXPOSE 3000 4001 4096

# 环境变量
ENV NODE_ENV=production
ENV WORK_DIR=/workspace
ENV BRIDGE_PORT=4096
ENV ACP_ENGINE=qwen-code
ENV WSS_SERVER_URL=ws://localhost:4001/ws

# 启动脚本
COPY <<'EOF' /app/start.sh
#!/bin/bash
set -e

echo "Starting OpenCode All-in-One..."

# 启动 wss-server (后台)
cd /app/wss
PORT=4001 ACP_COMMAND=qwen ACP_ARGS=--acp bun run dist/server.js &
WSS_PID=$!
echo "wss-server started (PID: $WSS_PID)"

# 等待 wss-server 启动
sleep 2

# 启动 bridge (后台)
cd /app/bridge
BRIDGE_PORT=4096 WSS_SERVER_URL=ws://localhost:4001/ws bun run src/index.ts &
BRIDGE_PID=$!
echo "bridge started (PID: $BRIDGE_PID)"

# 等待 bridge 启动
sleep 2

# 启动 web 前端
cd /app/web
bun run preview --port 3000 &
WEB_PID=$!
echo "web started (PID: $WEB_PID)"

# 信号处理
trap "kill $WSS_PID $BRIDGE_PID $WEB_PID; exit" SIGTERM SIGINT

# 等待所有进程
wait
EOF

RUN chmod +x /app/start.sh

WORKDIR /app
CMD ["/app/start.sh"]
