# 多阶段构建 Dockerfile
# - 构建 packages/app 微应用
# - 构建 packages/bridge
# - 构建 wss-server (TypeScript 编译)
# 最终镜像包含所有组件

FROM oven/bun:latest AS builder

WORKDIR /app

# 复制根目录配置文件
COPY package.json bun.lock ./
COPY patches/ patches/

# 只复制需要的 packages 的 package.json（用于依赖解析）
# 包含：app + bridge + opencode-qwen-acp-demo 及其 workspace 依赖
COPY packages/app/package.json packages/app/
COPY packages/bridge/package.json packages/bridge/
COPY packages/opencode-qwen-acp-demo/package.json packages/opencode-qwen-acp-demo/
COPY packages/sdk/js/package.json packages/sdk/js/
COPY packages/ui/package.json packages/ui/
COPY packages/util/package.json packages/util/

# 安装依赖（bun 会自动解析 workspace 依赖）
# 只安装上述 6 个包的依赖，不会安装其他 packages
RUN bun install --frozen-lockfile

# 复制源代码（只复制需要的包）
COPY packages/app/ packages/app/
COPY packages/bridge/ packages/bridge/
COPY packages/opencode-qwen-acp-demo/ packages/opencode-qwen-acp-demo/
COPY packages/sdk/js/ packages/sdk/js/
COPY packages/ui/ packages/ui/
COPY packages/util/ packages/util/

# 构建 packages/app 微应用
RUN cd packages/app && \
    BUILD_MODE=micro-app VITE_BASE_PATH=/opencode/app bunx vite build

# 构建 wss-server (TypeScript -> JavaScript)
RUN cd packages/opencode-qwen-acp-demo && \
    bun run build
# 运行时镜像
FROM node:20-slim

WORKDIR /app

# 安装必要的工具和 qwen-code CLI
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/* && \
    npm install -g @qwen-code/qwen-code http-server tsx || echo "Warning: Some global packages installation failed"

# 复制构建产物
COPY --from=builder /app/packages/app/dist ./app-dist

# 复制 bridge（源码 + 依赖）
COPY --from=builder /app/packages/bridge/src ./bridge-src
COPY --from=builder /app/packages/bridge/node_modules ./bridge-node_modules
COPY --from=builder /app/packages/bridge/package.json ./bridge-package.json

# 复制 wss-server (编译后的 JS 文件 + 依赖)
COPY --from=builder /app/packages/opencode-qwen-acp-demo/dist ./wss-dist
COPY --from=builder /app/packages/opencode-qwen-acp-demo/node_modules ./wss-node_modules
COPY --from=builder /app/packages/opencode-qwen-acp-demo/package.json ./wss-package.json

# 创建工作目录
RUN mkdir -p /workspace

# 暴露端口
# 3000: 微应用静态文件服务
# 5001: wss-server (WebSocket + HTTP 健康检查)
# 4096: bridge 对外暴露（通过 ingress /api）
EXPOSE 3000 5001 4096

# 环境变量
ENV BRIDGE_PORT=4096
ENV WSS_SERVER_URL=ws://localhost:5001/ws
ENV WORK_DIR=/workspace
ENV NODE_ENV=production
ENV ACP_COMMAND=qwen
ENV ACP_ARGS=--acp

# 启动脚本
RUN <<'EOF'
cat > /app/start.sh <<'START_SCRIPT'
#!/bin/sh
set -e

# 检查 qwen 是否可用
if command -v qwen > /dev/null 2>&1; then
  echo "✓ qwen CLI found: $(which qwen)"
else
  echo "⚠ qwen CLI not found in PATH, trying to use from npm global"
  # 尝试从 npm global 路径查找
  QWEN_PATH=$(find /usr/local/lib/node_modules/@qwen-code -name "qwen" -o -name "index.mjs" 2>/dev/null | head -1)
  if [ -n "$QWEN_PATH" ]; then
    export ACP_COMMAND=node
    export ACP_ARGS="$QWEN_PATH --acp"
    echo "✓ Using qwen from: $QWEN_PATH"
  else
    echo "✗ qwen CLI not available, service may fail"
  fi
fi

# 启动 wss-server (端口 5001)
echo "Starting wss-server on port 5001..."
cd /app && NODE_PATH=/app/wss-node_modules node wss-dist/wss-server.js > /tmp/wss-server.log 2>&1 &
WSS_PID=$!

# 等待 wss-server 启动
sleep 3

# 验证 wss-server 是否启动成功
if curl -s http://localhost:5001/health > /dev/null 2>&1; then
  echo "✓ wss-server started successfully"
else
  echo "✗ wss-server failed to start, check /tmp/wss-server.log"
  cat /tmp/wss-server.log
  exit 1
fi

# 启动 bridge (连接到 wss-server)
echo "Starting bridge on port $BRIDGE_PORT..."
cd /app && NODE_PATH=/app/bridge-node_modules tsx bridge-src/index.ts > /tmp/bridge.log 2>&1 &
BRIDGE_PID=$!

# 等待 bridge 启动
sleep 2

# 验证 bridge 是否启动成功
if curl -s http://localhost:$BRIDGE_PORT/global/health > /dev/null 2>&1; then
  echo "✓ bridge started successfully"
else
  echo "✗ bridge failed to start, check /tmp/bridge.log"
  cat /tmp/bridge.log
  exit 1
fi

# 启动静态文件服务器（微应用）
echo "Starting static server on port 3000..."
http-server app-dist \
  -p 3000 \
  -c-1 \
  -H "Access-Control-Allow-Origin:*" \
  -H "Access-Control-Allow-Methods:GET,POST,PUT,DELETE,OPTIONS" \
  -H "Access-Control-Allow-Headers:Content-Type" \
  > /tmp/static.log 2>&1 &
STATIC_PID=$!

echo "All services started:"
echo "  - WSS Server: http://localhost:5001 (WebSocket: ws://localhost:5001/ws)"
echo "  - Bridge: http://localhost:$BRIDGE_PORT"
echo "  - Static Server: http://localhost:3000"

# 等待所有进程
wait $WSS_PID $BRIDGE_PID $STATIC_PID
START_SCRIPT
chmod +x /app/start.sh
EOF

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:$BRIDGE_PORT/global/health || exit 1

ENTRYPOINT ["/app/start.sh"]
